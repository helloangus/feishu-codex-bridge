FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# 静态白名单；也可留空并使用下方的安全配对码。
FEISHU_ALLOWED_OPEN_IDS=ou_xxx
# 设置随机配对码后，未授权用户可私聊机器人发送 `/pair <配对码>` 加入本机白名单。
# 配对用户保存在 CODEX_ALLOWED_OPEN_IDS_FILE；完成配对后应删除此项并重启服务。
# FEISHU_PAIRING_CODE=replace-with-a-long-random-secret
CODEX_BRIDGE_CWD=/data/data/com.termux/files/home/project
# Required: permitted root for `/cd`; must contain CODEX_BRIDGE_CWD.
CODEX_WORKSPACE_ROOT=/data/data/com.termux/files/home
CODEX_MODEL=
# Optional; defaults to .feishu-codex-settings in CODEX_BRIDGE_CWD.
# CODEX_SETTINGS_FILE=/data/data/com.termux/files/home/project/.feishu-codex-settings
CODEX_APP_SERVER="codex app-server --enable collaboration_modes"
# Termux 若无法运行 Codex Linux sandbox，可显式改为 dangerFullAccess。
CODEX_SANDBOX_MODE=workspaceWrite
CODEX_MAX_ATTACHMENT_BYTES=20971520
CODEX_APPROVAL_TIMEOUT_SECONDS=600
# Optional; defaults to .feishu-codex-session in CODEX_BRIDGE_CWD.
# CODEX_SESSION_FILE=/data/data/com.termux/files/home/project/.feishu-codex-session
# Optional; defaults to .feishu-codex-seen-messages in CODEX_BRIDGE_CWD.
# CODEX_SEEN_MESSAGES_FILE=/data/data/com.termux/files/home/project/.feishu-codex-seen-messages
# Optional; defaults to .feishu-codex-allowed-open-ids in CODEX_BRIDGE_CWD.
# CODEX_ALLOWED_OPEN_IDS_FILE=/data/data/com.termux/files/home/project/.feishu-codex-allowed-open-ids
