FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# 建议填写自己的 open_id。留空会允许任何能私聊机器人的用户使用它。
FEISHU_ALLOWED_OPEN_IDS=ou_xxx
CODEX_BRIDGE_CWD=/data/data/com.termux/files/home/project
CODEX_MODEL=
# Optional; defaults to .feishu-codex-settings in CODEX_BRIDGE_CWD.
# CODEX_SETTINGS_FILE=/data/data/com.termux/files/home/project/.feishu-codex-settings
CODEX_APP_SERVER="codex app-server"
CODEX_MAX_ATTACHMENT_BYTES=20971520
CODEX_APPROVAL_TIMEOUT_SECONDS=600
# Optional; defaults to .feishu-codex-session in CODEX_BRIDGE_CWD.
# CODEX_SESSION_FILE=/data/data/com.termux/files/home/project/.feishu-codex-session
